{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daimon.network/schemas/source/v0/scenarios.schema.json",
  "title": "DM-015 Section 14 executable evidence registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "row_count", "rows", "schema", "section", "spec_path", "spec_sha256"
  ],
  "properties": {
    "row_count": {"type": "integer", "minimum": 80, "maximum": 128},
    "rows": {
      "type": "array",
      "minItems": 80,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence", "id", "index", "required_result", "scenario"],
        "properties": {
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.]{5,255}$"
            }
          },
          "id": {"type": "string", "pattern": "^source-s14-[0-9]{3}$"},
          "index": {"type": "integer", "minimum": 1, "maximum": 128},
          "required_result": {"type": "string", "minLength": 1, "maxLength": 512},
          "scenario": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "schema": {"const": "dm.source-section14-registry/v0"},
    "section": {"const": "14"},
    "spec_path": {"const": "specs/source-ancestry.md"},
    "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
