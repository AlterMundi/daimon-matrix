          "if": {
            "properties": {
              "mode": {
                "const": "manual"
              }
            }
          },
          "then": {
            "properties": {
              "interval": {
                "type": "null"
              },
              "max_cycles": {
                "const": 1
              }
            }
          },
          "else": {
            "properties": {
              "interval": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "revision": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "predecessor": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "predecessor": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
