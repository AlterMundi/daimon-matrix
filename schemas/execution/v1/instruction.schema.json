                    "const": "messaging_reply"
                  },
                  "action": {
                    "const": "reply"
                  }
                }
              }
            ]
          }
        },
        "state": {
          "enum": [
            "pending",
            "active",
            "superseded",
            "expired",
            "completed",
            "cancelled"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "next_eligible_slot": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "in_flight": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cycle_id",
              "slot",
              "deadline",
              "state",
              "outcome"
            ],
            "properties": {
              "cycle_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9:._/-]{1,200}$"
              },
              "slot": {
                "type": "integer",
                "minimum": 0
              },
              "deadline": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "state": {
                "enum": [
                  "intent",
                  "ambiguous",
                  "completed",
                  "stopped"
                ]
              },
              "outcome": {
                "enum": [
                  null,
                  "completed",
                  "stopped"
                ]
              }
            }
          }
        },
        "last_outcome": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
