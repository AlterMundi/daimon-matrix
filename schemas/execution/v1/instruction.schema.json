        },
        "instruction_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "codex_registration": {
      "title": "Separately human-approved Codex execution registration (NOT DM-040 V1 profile)",
      "description": "ApprovalVerifier approve proof covers this whole distinct schema object. External existing-body/provider ownership verification is mandatory. Fresh ephemeral review threads, single request, no tools, finite registration; no schedule or auth material.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal",
        "store_id",
        "being",
        "embodiment",
        "runner",
        "session",
        "provider",
        "model",
