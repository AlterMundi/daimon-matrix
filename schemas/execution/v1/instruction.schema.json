          "type": "string",
          "pattern": "^[A-Za-z0-9:._/-]{1,200}$"
        },
        "session": {
          "type": "string",
          "pattern": "^[A-Za-z0-9:._/-]{1,200}$"
        },
        "provider": {
          "type": "string",
          "pattern": "^[A-Za-z0-9:._/-]{1,200}$"
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9:._/-]{1,200}$"
        },
        "schema": {
          "const": "execution/v1/codex-registration"
        },
        "endpoint": {
          "type": "string",
          "pattern": "^(https://[^/?#@]+|http://127\\.0\\.0\\.1:[0-9]+)/[^?#]*responses$"
        },
        "profile": {
          "type": "string",
          "pattern": "^/"
        },
        "catalog_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expires": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "const": "ephemeral-review"
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        }
      }
    }
