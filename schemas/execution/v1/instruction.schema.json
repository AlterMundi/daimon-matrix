            ],
            "properties": {
              "channel": {
                "type": "string",
                "pattern": "^[A-Za-z0-9:._/-]{1,200}$"
              },
              "thread": {
                "type": "string",
                "pattern": "^[A-Za-z0-9:._/-]{1,200}$"
              },
              "tool": {
                "enum": [
                  "messaging_inbox",
                  "messaging_send",
                  "messaging_reply"
                ]
              },
              "action": {
                "enum": [
                  "review",
                  "send",
