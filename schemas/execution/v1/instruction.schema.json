                  "minimum": 0
                },
                "deadline": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "state": {
                  "enum": [
                    "intent",
                    "ambiguous",
                    "completed",
                    "stopped"
                  ]
                },
                "outcome": {
                  "enum": [
                    null,
                    "completed",
                    "stopped"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
