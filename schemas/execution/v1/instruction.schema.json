    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store_id",
        "instruction_id",
        "revision",
        "principal",
        "instruction_sha256"
      ],
      "properties": {
        "store_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9:._/-]{1,200}$"
        },
        "instruction_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9:._/-]{1,200}$"
