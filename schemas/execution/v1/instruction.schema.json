        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9:._/-]{1,200}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "start": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_cycle_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "cleanup_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_cycles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_effects": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_input_tokens": {
          "type": "integer",
