{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daimon.network/schemas/curator/v1/result.schema.json",
  "title": "Claim-bound curator result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "item_id", "claim_id", "resource_ref", "generation", "actor_origin", "outcome", "output_refs", "human_review_required", "effect_receipt", "completed_at_ms"],
  "properties": {
    "schema": {"const": "dm.curator.result/v1"},
    "result_id": {"type": "string", "pattern": "^dm:curator-result:v1:[A-Za-z0-9_-]{43}$"},
    "item_id": {"type": "string", "pattern": "^dm:curator-item:v1:[A-Za-z0-9_-]{43}$"},
    "claim_id": {"type": "string", "format": "uuid"},
    "resource_ref": {"$ref": "#/$defs/scoped"},
    "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "actor_origin": {"$ref": "#/$defs/origin"},
    "outcome": {"enum": ["completed", "proposed", "deferred", "failed"]},
    "output_refs": {"type": "array", "uniqueItems": true, "maxItems": 256, "items": {"$ref": "#/$defs/scoped"}},
    "human_review_required": {"type": "boolean"},
    "effect_receipt": {"anyOf": [{"type": "null"}, {"$ref": "../../cluster/v1/effect-receipt.schema.json"}]},
    "completed_at_ms": {"$ref": "#/$defs/uint"}
  },
  "allOf": [
    {
      "if": {"properties": {"human_review_required": {"const": true}}, "required": ["human_review_required"]},
      "then": {"properties": {"outcome": {"not": {"const": "completed"}}}}
    },
    {
      "if": {"properties": {"outcome": {"not": {"const": "completed"}}}, "required": ["outcome"]},
      "then": {"properties": {"effect_receipt": {"type": "null"}}}
    }
  ],
  "$defs": {
    "scoped": {"type": "string", "pattern": "^[A-Za-z0-9._:@-]{1,256}$"},
    "uint": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "origin": {
      "type": "object", "additionalProperties": false,
      "required": ["body_ref", "embodiment_id", "incarnation_id", "principal_id"],
      "properties": {
        "body_ref": {"$ref": "#/$defs/scoped"},
        "embodiment_id": {"$ref": "#/$defs/scoped"},
        "incarnation_id": {"$ref": "#/$defs/scoped"},
        "principal_id": {"$ref": "#/$defs/scoped"}
      }
    }
  }
}
