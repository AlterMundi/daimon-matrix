        {"properties": {"method": {"const": "scope.resolve"}, "params": {"$ref": "#/$defs/scopeResolveParams"}}},
        {"properties": {"method": {"const": "scope.tribe"}, "params": {"$ref": "#/$defs/scopeTribeParams"}}},
        {"properties": {"method": {"const": "scope.we"}, "params": {"$ref": "#/$defs/empty"}}},
        {"properties": {"method": {"const": "scope.we.diff"}, "params": {"$ref": "#/$defs/empty"}}},
        {"properties": {"method": {"const": "scope.we.sync-plan"}, "params": {"$ref": "#/$defs/scopeSyncPlanParams"}}},
        {"properties": {"method": {"const": "relationship.accept"}, "params": {"$ref": "#/$defs/relationshipPayloadParams"}}},
        {"properties": {"method": {"const": "relationship.card.publish"}, "params": {"$ref": "#/$defs/relationshipPayloadParams"}}},
        {"properties": {"method": {"const": "relationship.close"}, "params": {"$ref": "#/$defs/relationshipPayloadParams"}}},
