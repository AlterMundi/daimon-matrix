        {"properties": {"method": {"const": "communication.route-ack"}, "params": {"$ref": "#/$defs/communicationRouteAckParams"}}},
        {"properties": {"method": {"const": "route.inspect"}, "params": {"$ref": "#/$defs/routeInspectParams"}}},
        {"properties": {"method": {"const": "route.submit"}, "params": {"$ref": "#/$defs/routeSubmitParams"}}},
