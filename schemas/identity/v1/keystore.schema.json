{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daimon-matrix.local/schemas/identity/v1/keystore.schema.json",
  "title": "Daimon Matrix encrypted keystore V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["aead", "ciphertext", "counter", "kdf", "schema"],
  "properties": {
    "schema": {"const": "dm.keystore/v1"},
    "counter": {"type": "integer", "minimum": 1},
    "kdf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "name", "p", "r", "salt"],
      "properties": {
        "name": {"const": "scrypt"},
        "n": {"const": 16384},
        "r": {"const": 8},
        "p": {"const": 1},
        "salt": {"type": "string", "pattern": "^[A-Za-z0-9_-]{22}$"}
      }
    },
    "aead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "nonce"],
      "properties": {
        "name": {"const": "AES-256-GCM"},
        "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16}$"}
      }
    },
    "ciphertext": {"type": "string", "minLength": 22, "pattern": "^[A-Za-z0-9_-]+$"}
  }
}
