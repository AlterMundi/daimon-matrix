{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daimon.network/schemas/identity/v2/embodiment-credential.schema.json",
  "title": "V2 root-authorized embodiment credential",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "artifact_id",
    "body",
    "signatures"
  ],
  "properties": {
    "schema": {
      "const": "dm.identity.artifact/v2"
    },
    "kind": {
      "const": "embodiment-credential"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^dm:identity:v2:[A-Za-z0-9_-]{43}$"
    },
    "body": {
      "$ref": "#/$defs/embodimentCredential"
    },
    "signatures": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/signature"
      }
    }
  },
  "$defs": {
    "b64_32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "public"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "Ed25519",
            "X25519"
          ]
        },
        "key_id": {
          "type": "string",
          "pattern": "^dm:key:v1:[A-Za-z0-9_-]{43}$"
        },
        "public": {
          "$ref": "#/$defs/b64_32"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "role",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^dm:key:v1:[A-Za-z0-9_-]{43}$"
        },
        "role": {
          "enum": [
            "root-authorization",
            "embodiment-acceptance"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "transportPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "principal_id",
        "scheme"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "principal_id": {
          "type": "string",
          "minLength": 1
        },
        "scheme": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "embodimentCredential": {
      "allOf": [{"if": {"properties": {"validity": {"properties": {"mode": {"const": "until-revoked"}}}}}, "then": {"properties": {"purposes": {"contains": {"const": "messages"}}}}}],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "being_ref",
        "body_ref",
        "control_head",
        "embodiment_id",
        "encryption_key",
        "purposes",
        "revocation_generation",
        "signing_key",
        "transport_principals",
        "validity"
      ],
      "properties": {
        "being_ref": {
          "type": "string",
          "pattern": "^dm:being:v1:"
        },
        "body_ref": {
          "type": "string",
          "minLength": 1
        },
        "control_head": {
          "type": "string",
          "pattern": "^dm:identity:v1:"
        },
        "embodiment_id": {
          "type": "string",
          "minLength": 1
        },
        "encryption_key": {
          "$ref": "#/$defs/key"
        },
        "purposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "revocation_generation": {
          "type": "integer",
          "minimum": 0
        },
        "signing_key": {
          "$ref": "#/$defs/key"
        },
        "transport_principals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/transportPrincipal"
          }
        },
        "validity": {
          "$ref": "#/$defs/validity"
        }
      }
    },
    "validity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "not_before_ms"
          ],
          "properties": {
            "mode": {
              "const": "until-revoked"
            },
            "not_before_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "not_before_ms",
            "not_after_ms"
          ],
          "properties": {
            "mode": {
              "const": "finite"
            },
            "not_before_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "not_after_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      ]
    }
  }
}
