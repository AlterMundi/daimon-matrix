{
  "$defs": {
    "activation_bundle": {
      "additionalProperties": false,
      "properties": {
        "activation_id": {
          "$ref": "#/$defs/content_id"
        },
        "body_description": {
          "$ref": "#/$defs/artifact_ref"
        },
        "capability_description": {
          "$ref": "#/$defs/artifact_ref"
        },
        "event_checkpoint": {
          "$ref": "#/$defs/artifact_ref"
        },
        "event_cutoff": {
          "minimum": 0,
          "type": "integer"
        },
        "external_lease_receipt": {
          "$ref": "#/$defs/artifact_ref"
        },
        "me_id": {
          "$ref": "#/$defs/content_id"
        },
        "operational_acceptance": {
          "$ref": "#/$defs/artifact_ref"
        },
        "operational_certificate": {
          "$ref": "#/$defs/artifact_ref"
        },
        "predecessor_deployment_fence": {
          "$ref": "#/$defs/fence_position"
        },
        "presence_lease": {
          "$ref": "#/$defs/artifact_ref"
        },
        "projection_manifest": {
          "$ref": "#/$defs/artifact_ref"
        },
        "route_handles": {
          "items": {
            "pattern": "^opaque:[A-Za-z0-9._-]{1,128}$",
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "schema": {
          "const": "daimon-activation-bundle/v0"
        },
        "species_release": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "activation_id",
        "body_description",
        "capability_description",
        "event_checkpoint",
        "event_cutoff",
        "external_lease_receipt",
        "me_id",
        "operational_acceptance",
        "operational_certificate",
        "predecessor_deployment_fence",
        "presence_lease",
        "projection_manifest",
        "route_handles",
        "schema",
        "species_release"
      ],
      "type": "object"
    },
    "adapter_error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9.-]{0,63}$",
          "type": "string"
        },
        "detail": {
          "maxLength": 512,
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "detail",
        "retryable"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "adapter_invocation": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "$ref": "#/$defs/content_id"
        },
        "context": {
          "additionalProperties": false,
          "properties": {
            "route_handles": {
              "items": {
                "pattern": "^opaque:[A-Za-z0-9._-]{1,128}$",
                "type": "string"
              },
              "maxItems": 64,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "route_handles"
          ],
          "type": "object"
        },
        "contract": {
          "$ref": "#/$defs/contract_name"
        },
        "idempotency_key": {
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/artifact_ref"
          },
          "maxItems": 128,
          "type": "array",
          "uniqueItems": true
        },
        "limits": {
          "additionalProperties": false,
          "properties": {
            "deadline_ms": {
              "maximum": 86400000,
              "minimum": 1,
              "type": "integer"
            },
            "max_output_bytes": {
              "maximum": 2097152,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "deadline_ms",
            "max_output_bytes"
          ],
          "type": "object"
        },
        "operation": {
          "pattern": "^[a-z][a-z0-9.-]{0,63}$",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "schema": {
          "const": "daimon-adapter-invocation/v0"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "version": {
          "const": "v0"
        }
      },
      "required": [
        "adapter_id",
        "context",
        "contract",
        "idempotency_key",
        "inputs",
        "limits",
        "operation",
        "request_id",
        "schema",
        "subject",
        "version"
      ],
      "type": "object"
    },
    "adapter_manifest": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "$ref": "#/$defs/content_id"
        },
        "authority": {
          "$ref": "#/$defs/authority_denial"
        },
        "capabilities": {
          "items": {
            "pattern": "^[a-z][a-z0-9.-]{0,63}$",
            "type": "string"
          },
          "maxItems": 128,
          "type": "array",
          "uniqueItems": true
        },
        "contracts": {
          "items": {
            "$ref": "#/$defs/contract_offer"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "limits": {
          "additionalProperties": false,
          "properties": {
            "max_input_bytes": {
              "maximum": 2097152,
              "minimum": 1,
              "type": "integer"
            },
            "max_output_bytes": {
              "maximum": 2097152,
              "minimum": 1,
              "type": "integer"
            },
            "max_runtime_ms": {
              "maximum": 86400000,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "max_input_bytes",
            "max_output_bytes",
            "max_runtime_ms"
          ],
          "type": "object"
        },
        "provider_kind": {
          "$ref": "#/$defs/provider_kind"
        },
        "schema": {
          "const": "daimon-adapter-manifest/v0"
        }
      },
      "required": [
        "adapter_id",
        "authority",
        "capabilities",
        "contracts",
        "limits",
        "provider_kind",
        "schema"
      ],
      "type": "object"
    },
    "adapter_result": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "error": {
                "type": "object"
              }
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "adapter_id": {
          "$ref": "#/$defs/content_id"
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/artifact_ref"
          },
          "maxItems": 128,
          "type": "array",
          "uniqueItems": true
        },
        "error": {
          "$ref": "#/$defs/adapter_error"
        },
        "invocation_sha256": {
          "$ref": "#/$defs/digest"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/artifact_ref"
          },
          "maxItems": 128,
          "type": "array",
          "uniqueItems": true
        },
        "request_id": {
          "pattern": "^[0-9a-f-]{36}$",
          "type": "string"
        },
        "result_id": {
          "$ref": "#/$defs/content_id"
        },
        "schema": {
          "const": "daimon-adapter-result/v0"
        },
        "status": {
          "enum": [
            "accepted",
            "failed",
            "incomplete",
            "refused"
          ],
          "type": "string"
        }
      },
      "required": [
        "adapter_id",
        "effects",
        "error",
        "invocation_sha256",
        "outputs",
        "request_id",
        "result_id",
        "schema",
        "status"
      ],
      "type": "object"
    },
    "artifact_ref": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/content_id"
        },
        "bytes": {
          "maximum": 2097152,
          "minimum": 1,
          "type": "integer"
        },
        "media_type": {
          "enum": [
            "application/daimon+jcs",
            "application/json",
            "application/octet-stream"
          ],
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "artifact_id",
        "bytes",
        "media_type",
        "sha256"
      ],
      "type": "object"
    },
