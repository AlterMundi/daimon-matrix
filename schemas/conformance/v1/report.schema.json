{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daimon.network/schemas/conformance/v1/report.schema.json",
  "title": "Daimon local conformance report V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "suite_version", "source_commit", "registry_hash", "fixture_seed", "environment", "artifacts", "transcript", "transcript_sha256", "release_ready"],
  "properties": {
    "schema": {"const": "dm.conformance.report/v1"},
    "suite_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "source_commit": {"$ref": "#/$defs/commit"},
    "registry_hash": {"$ref": "#/$defs/hash"},
    "fixture_seed": {"type": "string", "minLength": 1, "maxLength": 128},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "sqlite", "system", "machine", "journal_mode", "synchronous"],
      "properties": {
        "python": {"type": "string"},
        "sqlite": {"type": "string"},
        "system": {"type": "string"},
        "machine": {"type": "string"},
        "journal_mode": {"const": "delete"},
        "synchronous": {"const": "FULL"}
      }
    },
    "artifacts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}},
    "transcript": {"$ref": "#/$defs/transcript"},
    "transcript_sha256": {"$ref": "#/$defs/hash"},
    "release_ready": {"type": "boolean"}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "status", "reason", "evidence", "diagnostic_hashes"],
      "properties": {
        "scenario_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "status": {"enum": ["pass", "fail", "skip"]},
        "reason": {"type": ["string", "null"]},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "diagnostic_hashes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}}
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "suite_version", "registry_hash", "fixture_seed", "schedule", "scenarios"],
      "properties": {
        "schema": {"const": "dm.conformance.transcript/v1"},
        "suite_version": {"type": "string"},
        "registry_hash": {"$ref": "#/$defs/hash"},
        "fixture_seed": {"type": "string"},
        "schedule": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
        "scenarios": {"type": "array", "items": {"$ref": "#/$defs/outcome"}}
      }
    }
  }
}
