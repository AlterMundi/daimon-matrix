{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daimon.network/schemas/conformance/v1/registry.schema.json",
  "title": "Daimon local conformance registry V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "suite_version", "fixture_seed", "scenarios"],
  "properties": {
    "schema": {"const": "dm.conformance.registry/v1"},
    "suite_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "fixture_seed": {"type": "string", "minLength": 1, "maxLength": 128},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 1024},
    "texts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owners", "specifications", "setup", "stimulus", "fault", "expected", "evidence", "cleanup", "platform", "ci_lane", "required"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "owners": {"$ref": "#/$defs/texts"},
        "specifications": {"$ref": "#/$defs/texts"},
        "setup": {"$ref": "#/$defs/text"},
        "stimulus": {"$ref": "#/$defs/text"},
        "fault": {"$ref": "#/$defs/text"},
        "expected": {"$ref": "#/$defs/text"},
        "evidence": {"$ref": "#/$defs/texts"},
        "cleanup": {"$ref": "#/$defs/text"},
        "platform": {"enum": ["all", "linux"]},
        "ci_lane": {"enum": ["fast", "complete"]},
        "required": {"const": true}
      }
    }
  }
}
