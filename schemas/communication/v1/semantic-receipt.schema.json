{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daimon.network/schemas/communication/v1/semantic-receipt.schema.json",
  "title": "Canonical terminal receipt projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "leg_id", "receipt_event_id", "receipt_hash", "outcome"],
  "properties": {
    "schema": {"const": "dm.semantic-receipt/v1"},
    "leg_id": {"type": "string", "pattern": "^dm:semantic-leg:v1:[A-Za-z0-9_-]{43}$"},
    "receipt_event_id": {"type": "string", "format": "uuid"},
    "receipt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "outcome": {
      "enum": [
        "delivered", "failed:transport", "refused:policy", "expired",
        "resolved:unroutable"
      ]
    }
  }
}
