{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daimon.network/schemas/communication/v1/disclosure-authorization-input.schema.json",
  "title": "Verified disclosure authorization input V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "authorization_id", "authorized_at_ms", "expires_at_ms",
    "event_id", "event_hash", "sensitivity", "sender", "recipients",
    "evidence_hash"
  ],
  "properties": {
    "schema": {"const": "dm.disclosure-authorization-input/v1"},
    "authorization_id": {"type": "string", "format": "uuid"},
    "authorized_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "expires_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "event_id": {"type": "string", "format": "uuid"},
    "event_hash": {"$ref": "#/$defs/hash"},
    "sensitivity": {"enum": ["personal", "private", "shareable"]},
    "sender": {"$ref": "#/$defs/sender"},
    "recipients": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {"$ref": "#/$defs/recipient"}
    },
    "evidence_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sender": {
      "type": "object", "additionalProperties": false,
      "required": ["being_ref", "credential_id", "embodiment_id", "incarnation_id", "signing_kid"],
      "properties": {
        "being_ref": {"type": "string", "pattern": "^dm:being:v1:[A-Za-z0-9_-]{43}$"},
        "credential_id": {"type": "string", "pattern": "^dm:identity:v1:[A-Za-z0-9_-]{43}$"},
        "embodiment_id": {"type": "string", "pattern": "^embodiment:[A-Za-z0-9._:-]{1,240}$"},
        "incarnation_id": {"type": "string", "pattern": "^incarnation:[A-Za-z0-9._:-]{1,240}$"},
        "signing_kid": {"type": "string", "pattern": "^dm:key:v1:[A-Za-z0-9_-]{43}$"}
      }
    },
    "recipient": {
      "type": "object", "additionalProperties": false,
      "required": ["being_ref", "credential_id", "embodiment_id", "encryption_kid"],
      "properties": {
        "being_ref": {"type": "string", "pattern": "^dm:being:v1:[A-Za-z0-9_-]{43}$"},
        "credential_id": {"type": "string", "pattern": "^dm:identity:v1:[A-Za-z0-9_-]{43}$"},
        "embodiment_id": {"type": "string", "pattern": "^embodiment:[A-Za-z0-9._:-]{1,240}$"},
        "encryption_kid": {"type": "string", "pattern": "^dm:key:v1:[A-Za-z0-9_-]{43}$"}
      }
    }
  }
}
