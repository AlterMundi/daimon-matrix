{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daimon.network/schemas/communication/v1/sealed-delivery.schema.json",
  "title": "Daimon Matrix root-bound sealed delivery V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "profile", "delivery_id", "event_id", "event_hash", "sensitivity",
    "authorization_id", "evidence_hash", "issued_at_ms", "expires_at_ms",
    "sender", "recipients", "payload", "signature"
  ],
  "properties": {
    "schema": {"const": "dm.sealed-delivery/v1"},
    "profile": {"const": "HPKE-X25519-HKDF-SHA256-CHACHA20POLY1305+ED25519+JCS/v1"},
    "delivery_id": {"type": "string", "format": "uuid"},
    "event_id": {"type": "string", "format": "uuid"},
    "event_hash": {"$ref": "#/$defs/hash"},
    "sensitivity": {"enum": ["personal", "private", "shareable"]},
    "authorization_id": {"type": "string", "format": "uuid"},
    "evidence_hash": {"$ref": "#/$defs/hash"},
    "issued_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "expires_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "sender": {"$ref": "#/$defs/sender"},
    "recipients": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {"$ref": "#/$defs/recipient"}
    },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["nonce", "ciphertext"],
      "properties": {
        "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16}$"},
        "ciphertext": {"type": "string", "minLength": 22, "maxLength": 1398123, "pattern": "^[A-Za-z0-9_-]+$"}
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["alg", "kid", "role", "value"],
      "properties": {
        "alg": {"const": "Ed25519"},
        "kid": {"type": "string", "pattern": "^dm:key:v1:[A-Za-z0-9_-]{43}$"},
        "role": {"const": "delivery-authorization"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sender": {
      "type": "object", "additionalProperties": false,
      "required": ["being_ref", "credential_id", "embodiment_id", "incarnation_id", "signing_kid"],
      "properties": {
        "being_ref": {"type": "string", "pattern": "^dm:being:v1:[A-Za-z0-9_-]{43}$"},
        "credential_id": {"type": "string", "pattern": "^dm:identity:v1:[A-Za-z0-9_-]{43}$"},
        "embodiment_id": {"type": "string", "pattern": "^embodiment:[A-Za-z0-9._:-]{1,240}$"},
        "incarnation_id": {"type": "string", "pattern": "^incarnation:[A-Za-z0-9._:-]{1,240}$"},
        "signing_kid": {"type": "string", "pattern": "^dm:key:v1:[A-Za-z0-9_-]{43}$"}
      }
    },
    "recipient": {
      "type": "object", "additionalProperties": false,
      "required": ["being_ref", "credential_id", "embodiment_id", "encryption_kid", "enc", "wrapped_cek"],
      "properties": {
        "being_ref": {"type": "string", "pattern": "^dm:being:v1:[A-Za-z0-9_-]{43}$"},
        "credential_id": {"type": "string", "pattern": "^dm:identity:v1:[A-Za-z0-9_-]{43}$"},
        "embodiment_id": {"type": "string", "pattern": "^embodiment:[A-Za-z0-9._:-]{1,240}$"},
        "encryption_kid": {"type": "string", "pattern": "^dm:key:v1:[A-Za-z0-9_-]{43}$"},
        "enc": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
        "wrapped_cek": {"type": "string", "pattern": "^[A-Za-z0-9_-]{64}$"}
      }
    }
  }
}
