{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daimon.network/schemas/review/v1/revocation.schema.json",
  "title": "Subject-authored reviewer delegation revocation",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "revocation_id", "authorization_id", "authorization_event_id", "reason", "revoked_at_ms"],
  "properties": {
    "schema": {"const": "dm.review.revocation/v1"},
    "revocation_id": {"type": "string", "pattern": "^dm:review-revocation:v1:[A-Za-z0-9_-]{43}$"},
    "authorization_id": {"type": "string", "pattern": "^dm:review-authorization:v1:[A-Za-z0-9_-]{43}$"},
    "authorization_event_id": {"type": "string", "format": "uuid"},
    "reason": {"type": "string", "pattern": "^[A-Za-z0-9._:@-]{1,256}$"},
    "revoked_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  }
}
