{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daimon.network/schemas/review/v1/request.schema.json",
  "title": "Exact immutable human review request",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "review_request_id", "subject_me_id", "policy", "policy_hash", "candidate", "candidate_hash", "plan", "plan_hash", "proposal", "proposal_hash", "authorization_ids", "group_id", "threshold", "requested_action", "predecessor_review_request_id", "classification", "consent", "reasons", "projected_effect_hash", "requested_at_ms", "expires_at_ms"],
  "properties": {
    "schema": {"const": "dm.review.request/v1"},
    "review_request_id": {"type": "string", "pattern": "^dm:review-request:v1:[A-Za-z0-9_-]{43}$"},
    "subject_me_id": {"$ref": "#/$defs/scoped"},
    "policy": {"$ref": "../../memory/v1/policy.schema.json"},
    "policy_hash": {"$ref": "#/$defs/hash"},
    "candidate": {"$ref": "../../memory/v1/candidate.schema.json"},
    "candidate_hash": {"$ref": "#/$defs/hash"},
    "plan": {"$ref": "../../memory/v1/transition-plan.schema.json"},
    "plan_hash": {"$ref": "#/$defs/hash"},
    "proposal": {"anyOf": [{"type": "null"}, {"$ref": "../../curator-worker/v1/proposal.schema.json"}]},
    "proposal_hash": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
    "authorization_ids": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^dm:review-authorization:v1:[A-Za-z0-9_-]{43}$"}},
    "group_id": {"type": "string", "pattern": "^dm:review-group:v1:[A-Za-z0-9_-]{43}$"},
    "threshold": {"type": "integer", "minimum": 1, "maximum": 16},
    "requested_action": {"const": "memory-transition"},
    "predecessor_review_request_id": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^dm:review-request:v1:[A-Za-z0-9_-]{43}$"}]},
    "classification": {"enum": ["public", "personal", "private", "protected"]},
    "consent": {"enum": ["granted", "unknown", "denied"]},
    "reasons": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/scoped"}},
    "projected_effect_hash": {"$ref": "#/$defs/hash"},
    "requested_at_ms": {"$ref": "#/$defs/uint"},
    "expires_at_ms": {"$ref": "#/$defs/uint"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "uint": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "scoped": {"type": "string", "pattern": "^[A-Za-z0-9._:@-]{1,256}$"}
  }
}
