{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daimon.network/schemas/review/v1/authorization.schema.json",
  "title": "Purpose-limited human reviewer delegation accepted by its key holder",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authorization_id", "subject_me_id", "policy_id", "policy_hash", "reviewer", "group", "scopes", "valid_from_ms", "expires_at_ms", "max_outstanding_decisions", "control_position", "issued_at_ms", "acceptance"],
  "properties": {
    "schema": {"const": "dm.review.authorization/v1"},
    "authorization_id": {"type": "string", "pattern": "^dm:review-authorization:v1:[A-Za-z0-9_-]{43}$"},
    "subject_me_id": {"$ref": "#/$defs/scoped"},
    "policy_id": {"type": "string", "pattern": "^dm:memory-policy:v1:[A-Za-z0-9_-]{43}$"},
    "policy_hash": {"$ref": "#/$defs/hash"},
    "reviewer": {"$ref": "#/$defs/key"},
    "group": {"$ref": "#/$defs/group"},
    "scopes": {"$ref": "#/$defs/scopes"},
    "valid_from_ms": {"$ref": "#/$defs/uint"},
    "expires_at_ms": {"$ref": "#/$defs/uint"},
    "max_outstanding_decisions": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "control_position": {"$ref": "#/$defs/control"},
    "issued_at_ms": {"$ref": "#/$defs/uint"},
    "acceptance": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "uint": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "scoped": {"type": "string", "pattern": "^[A-Za-z0-9._:@-]{1,256}$"},
    "key_id": {"type": "string", "pattern": "^dm:key:v1:[A-Za-z0-9_-]{43}$"},
    "key": {"type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "public"], "properties": {"algorithm": {"const": "Ed25519"}, "key_id": {"$ref": "#/$defs/key_id"}, "public": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}}},
    "signature": {"type": "object", "additionalProperties": false, "required": ["alg", "kid", "value"], "properties": {"alg": {"const": "Ed25519"}, "kid": {"$ref": "#/$defs/key_id"}, "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}}},
    "group": {"type": "object", "additionalProperties": false, "required": ["group_id", "member_key_ids", "threshold"], "properties": {"group_id": {"type": "string", "pattern": "^dm:review-group:v1:[A-Za-z0-9_-]{43}$"}, "member_key_ids": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/key_id"}}, "threshold": {"type": "integer", "minimum": 1, "maximum": 16}}},
    "scopes": {"type": "object", "additionalProperties": false, "required": ["categories", "classifications", "actions"], "properties": {"categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["personal-experience", "personal-insight", "personal-skill", "peer-attributed", "external-reference", "tribal-knowledge", "species-inheritance", "incarnation-state"]}}, "classifications": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["public", "personal", "private", "protected"]}}, "actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["accept", "edit", "reject", "defer"]}}}},
    "control": {"type": "object", "additionalProperties": false, "required": ["manifest_hash", "embodiment_id", "incarnation_id"], "properties": {"manifest_hash": {"$ref": "#/$defs/hash"}, "embodiment_id": {"$ref": "#/$defs/scoped"}, "incarnation_id": {"$ref": "#/$defs/scoped"}}}
  }
}
