        },
        "witness_sequence": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "schema",
        "matrix_session_id",
        "bootstrap_event_hash",
        "previous_event_hash",
        "previous_event_id",
        "witness_sequence"
      ],
      "type": "object"
    }
  },
