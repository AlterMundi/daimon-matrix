          "type": "string"
        },
        "matrix_session_id": {
          "pattern": "^dm:[a-z0-9-]+:v[01]:[A-Za-z0-9_-]{43}$",
          "type": "string"
        },
        "previous_event_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "previous_event_id": {
          "format": "uuid",
          "type": "string"
        },
        "schema": {
