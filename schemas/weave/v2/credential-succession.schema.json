{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "being_ref",
    "control_head",
    "previous_manifest_hash",
    "successor_manifest_hash",
    "previous_credential_id",
    "successor_credential_id",
    "previous_authorization_id",
    "successor_authorization_id",
    "embodiment_id",
    "incarnation_id",
    "migration_id",
    "content_hash",
    "previous_revision",
    "successor_revision",
    "issued_at_ms",
    "schema",
    "signatures",
    "acceptance"
  ],
  "properties": {
    "being_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "control_head": {
      "type": "string",
      "pattern": "^dm:identity:v1:[A-Za-z0-9_-]{43}$"
    },
    "previous_manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "successor_manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_credential_id": {
      "type": "string",
      "pattern": "^dm:identity:v1:[A-Za-z0-9_-]{43}$"
    },
    "successor_credential_id": {
      "type": "string",
      "pattern": "^dm:identity:v2:[A-Za-z0-9_-]{43}$"
    },
    "previous_authorization_id": {
      "type": "string",
      "pattern": "^dm:identity:v1:[A-Za-z0-9_-]{43}$"
    },
    "successor_authorization_id": {
      "type": "string",
      "pattern": "^dm:identity:v1:[A-Za-z0-9_-]{43}$"
    },
    "embodiment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "incarnation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "migration_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "successor_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "issued_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "schema": {
      "const": "dm.we.credential-succession/v2"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alg",
          "kid",
          "value"
        ],
        "properties": {
          "alg": {
            "const": "Ed25519"
          },
          "kid": {
            "type": "string",
            "pattern": "^dm:key:v1:[A-Za-z0-9_-]{43}$"
          },
          "value": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{86}$"
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "kid",
        "value"
      ],
      "properties": {
        "alg": {
          "const": "Ed25519"
        },
        "kid": {
          "type": "string",
          "pattern": "^dm:key:v1:[A-Za-z0-9_-]{43}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daimon.network/schemas/weave/v2/credential-succession.schema.json",
  "description": "Cryptographic verification additionally requires exact unchanged identity/keys/purposes/history and current root threshold plus embodiment acceptance."
}
