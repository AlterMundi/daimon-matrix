{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daimon.network/schemas/weave/v1/event.schema.json",
  "title": "dm.we.v1 event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "event_id", "being_ref", "manifest_hash", "origin",
    "sequence", "previous_event_id", "occurred_at_ms", "causal_parents",
    "kind", "subject", "payload", "supersedes", "sensitivity",
    "content_hash", "signature"
  ],
  "properties": {
    "protocol": {"const": "dm.we.v1"},
    "event_id": {"type": "string", "format": "uuid"},
    "being_ref": {
      "type": "string",
      "anyOf": [
        {"pattern": "^being:[0-9a-f-]{36}$"},
        {"pattern": "^dm:being:v1:[A-Za-z0-9_-]{43}$"}
      ]
    },
    "manifest_hash": {"$ref": "#/$defs/hash"},
    "origin": {
      "type": "object", "additionalProperties": false,
      "required": ["embodiment_id", "incarnation_id", "principal_id", "body_ref"],
      "properties": {
        "embodiment_id": {"type": "string", "pattern": "^embodiment:[A-Za-z0-9._:-]{1,240}$"},
        "incarnation_id": {"type": "string", "pattern": "^incarnation:[A-Za-z0-9._:-]{1,240}$"},
        "principal_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "body_ref": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "previous_event_id": {"type": ["string", "null"], "format": "uuid"},
    "occurred_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "causal_parents": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "kind": {"enum": ["experience.observed", "skill.proposed", "preference.proposed", "configuration.proposed", "adoption.decided", "projection.receipted", "lifecycle.announced", "memory.recorded", "review.authorization.issued", "review.authorization.revoked", "review.requested", "review.decided", "review.executed", "publication.requested", "publication.receipted"]},
    "subject": {"type": "string", "minLength": 1, "maxLength": 256},
    "payload": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {"$ref": "#/$defs/canonicalValue"}
    },
    "supersedes": {"type": ["string", "null"], "format": "uuid"},
    "sensitivity": {"enum": ["personal", "private", "shareable"]},
    "content_hash": {"$ref": "#/$defs/hash"},
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["alg", "kid", "value"],
      "properties": {
        "alg": {"const": "Ed25519"},
        "kid": {"type": "string", "minLength": 1, "maxLength": 128},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "adoption.decided"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target_event_id", "decision", "reason"],
            "properties": {
              "target_event_id": {"type": "string", "format": "uuid"},
              "decision": {"enum": ["adopt", "reject", "defer", "revert"]},
              "reason": {"type": "string", "minLength": 1, "maxLength": 1024}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "projection.receipted"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "actor", "adapter", "authority", "completed_at_ms",
              "decision_event_id", "intent_hash", "observed_postcondition",
              "preview_hash", "resource_fence", "result", "started_at_ms",
              "target_event_id"
            ],
            "properties": {
              "actor": {"type": "string", "minLength": 1, "maxLength": 128},
              "adapter": {"type": "string", "minLength": 1, "maxLength": 128},
              "authority": {"enum": ["daimon", "human"]},
              "completed_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
              "decision_event_id": {"type": "string", "format": "uuid"},
              "intent_hash": {"$ref": "#/$defs/hash"},
              "observed_postcondition": {
                "type": "object",
                "maxProperties": 64,
                "propertyNames": {"not": {"pattern": "(?:^|_)(?:address|api_key|bearer|credential|endpoint|password|passwd|path|private|secret|socket|token|url)(?:$|_)"}},
                "additionalProperties": {"$ref": "#/$defs/postconditionValue"}
              },
              "preview_hash": {"$ref": "#/$defs/hash"},
              "resource_fence": {
                "anyOf": [
                  {"type": "null"},
                  {"$ref": "#/$defs/resourceFencePosition"}
                ]
              },
              "result": {"enum": ["applied", "failed", "reconciled", "stale"]},
              "started_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
              "target_event_id": {"type": "string", "format": "uuid"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "memory.recorded"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "payload": {"$ref": "../../memory/v1/record.schema.json"}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "publication.requested"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "payload": {"$ref": "../../publication/v1/contracts.schema.json#/$defs/request"}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "publication.receipted"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "payload": {"$ref": "../../publication/v1/contracts.schema.json#/$defs/acceptance"}
        }
      }
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "resourceFencePosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "resource_ref", "holder_embodiment_id", "epoch", "evidence_hash"],
      "properties": {
        "schema": {"const": "dm.cluster-resource-fence-position/v1"},
        "resource_ref": {"type": "string", "minLength": 1, "maxLength": 240},
        "holder_embodiment_id": {"type": "string", "minLength": 1, "maxLength": 240},
        "epoch": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "evidence_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "postconditionValue": {
      "anyOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
        {
          "type": "string",
          "maxLength": 4096,
          "not": {"pattern": "(?:-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----|^(?:/|~[/\\\\]|file:|https?://))"}
        },
        {"type": "array", "items": {"$ref": "#/$defs/postconditionValue"}},
        {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {"not": {"pattern": "(?:^|_)(?:address|api_key|bearer|credential|endpoint|password|passwd|path|private|secret|socket|token|url)(?:$|_)"}},
          "additionalProperties": {"$ref": "#/$defs/postconditionValue"}
        }
      ]
    },
    "canonicalValue": {
      "anyOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
        {"type": "string", "maxLength": 65536},
        {"type": "array", "items": {"$ref": "#/$defs/canonicalValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/canonicalValue"}}
      ]
    }
  }
}
