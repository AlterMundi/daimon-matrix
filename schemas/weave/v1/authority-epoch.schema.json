{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daimon.network/schemas/weave/v1/authority-epoch.schema.json",
  "title": "Signed Weave root-authority epoch successor V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "being_ref", "previous_manifest_hash", "previous_revision",
    "successor_manifest_hash", "successor_revision", "embodiment_id",
    "previous_incarnation_id", "successor_incarnation_id",
    "successor_incarnation_authorization_id", "issued_at_ms", "content_hash",
    "signature"
  ],
  "properties": {
    "schema": {"const": "dm.we.authority-epoch/v1"},
    "being_ref": {"type": "string", "pattern": "^dm:being:v1:[A-Za-z0-9_-]{43}$"},
    "previous_manifest_hash": {"$ref": "#/$defs/hash"},
    "previous_revision": {"$ref": "#/$defs/positiveInteger"},
    "successor_manifest_hash": {"$ref": "#/$defs/hash"},
    "successor_revision": {"$ref": "#/$defs/positiveInteger"},
    "embodiment_id": {"type": "string", "pattern": "^embodiment:.{1,240}$"},
    "previous_incarnation_id": {"type": "string", "pattern": "^incarnation:.{1,240}$"},
    "successor_incarnation_id": {"type": "string", "pattern": "^incarnation:.{1,240}$"},
    "successor_incarnation_authorization_id": {
      "type": "string", "pattern": "^dm:identity:v1:[A-Za-z0-9_-]{43}$"
    },
    "issued_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "content_hash": {"$ref": "#/$defs/hash"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "kid", "value"],
      "properties": {
        "alg": {"const": "Ed25519"},
        "kid": {"type": "string", "pattern": "^dm:key:v1:[A-Za-z0-9_-]{43}$"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positiveInteger": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
  }
}
