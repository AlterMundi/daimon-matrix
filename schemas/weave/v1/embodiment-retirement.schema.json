{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daimon.network/schemas/weave/v1/embodiment-retirement.schema.json",
  "title": "Root-threshold signed surgical embodiment retirement V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "being_ref",
    "previous_manifest_hash",
    "previous_revision",
    "successor_manifest_hash",
    "successor_revision",
    "issued_at_ms",
    "content_hash",
    "signatures",
    "schema",
    "previous_control_head",
    "successor_control_head",
    "revocations"
  ],
  "properties": {
    "being_ref": {
      "type": "string",
      "pattern": "^dm:being:v1:[A-Za-z0-9_-]{43}$"
    },
    "previous_manifest_hash": {
      "$ref": "#/$defs/hash"
    },
    "previous_revision": {
      "$ref": "#/$defs/positiveInteger"
    },
    "successor_manifest_hash": {
      "$ref": "#/$defs/hash"
    },
    "successor_revision": {
      "$ref": "#/$defs/positiveInteger"
    },
    "issued_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "content_hash": {
      "$ref": "#/$defs/hash"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/signature"
      }
    },
    "schema": {
      "const": "dm.we.embodiment-retirement/v1"
    },
    "previous_control_head": {
      "type": "string",
      "pattern": "^dm:identity:v1:[A-Za-z0-9_-]{43}$"
    },
    "successor_control_head": {
      "type": "string",
      "pattern": "^dm:identity:v1:[A-Za-z0-9_-]{43}$"
    },
    "revocations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "kind",
          "artifact_id",
          "body",
          "signatures"
        ],
        "properties": {
          "schema": {
            "const": "dm.identity.artifact/v1"
          },
          "kind": {
            "const": "revocation"
          },
          "artifact_id": {
            "type": "string",
            "pattern": "^dm:identity:v1:[A-Za-z0-9_-]{43}$"
          },
          "body": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "being_ref",
              "control_generation",
              "control_sequence",
              "previous_control_head",
              "embodiment_id",
              "cutoff_incarnation_sequence",
              "revocation_generation"
            ],
            "properties": {
              "being_ref": {
                "type": "string",
                "pattern": "^dm:being:v1:[A-Za-z0-9_-]{43}$"
              },
              "previous_control_head": {
                "type": "string",
                "pattern": "^dm:identity:v1:[A-Za-z0-9_-]{43}$"
              },
              "control_generation": {
                "type": "integer",
                "minimum": 0
              },
              "control_sequence": {
                "type": "integer",
                "minimum": 1
              },
              "embodiment_id": {
                "type": "string",
                "pattern": "^embodiment:.{1,240}$"
              },
              "cutoff_incarnation_sequence": {
                "type": "integer",
                "minimum": 0
              },
              "revocation_generation": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "signatures": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "algorithm",
                "key_id",
                "role",
                "value"
              ],
              "properties": {
                "algorithm": {
                  "const": "Ed25519"
                },
                "key_id": {
                  "type": "string",
                  "pattern": "^dm:key:v1:[A-Za-z0-9_-]{43}$"
                },
                "role": {
                  "const": "root-authorization"
                },
                "value": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{86}$"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "kid",
        "value"
      ],
      "properties": {
        "alg": {
          "const": "Ed25519"
        },
        "kid": {
          "type": "string",
          "pattern": "^dm:key:v1:[A-Za-z0-9_-]{43}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}
