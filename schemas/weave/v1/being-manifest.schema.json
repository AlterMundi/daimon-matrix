{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daimon.network/schemas/weave/v1/being-manifest.schema.json",
  "title": "Provisional same-being manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "being_ref", "revision", "embodiments"],
  "properties": {
    "schema": {"const": "being-manifest/v1"},
    "being_ref": {"type": "string", "pattern": "^being:[0-9a-f-]{36}$"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "embodiments": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["embodiment_id", "principal_id", "body_ref", "status"],
        "properties": {
          "embodiment_id": {"type": "string", "pattern": "^embodiment:[0-9a-f-]{36}$"},
          "principal_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "body_ref": {"type": "string", "minLength": 1, "maxLength": 256},
          "status": {"enum": ["active", "retired"]}
        }
      }
    }
  }
}
