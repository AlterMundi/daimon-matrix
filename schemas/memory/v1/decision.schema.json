{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daimon.network/schemas/memory/v1/decision.schema.json",
  "title": "Content-addressed memory policy decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "decision_id", "policy_id", "candidate_id", "predecessor_decision_id", "subject_me_id", "checkpoint", "evaluated_at_ms", "expires_at_ms", "outcome", "reasons"],
  "properties": {
    "schema": {"const": "dm.memory.policy-decision/v1"},
    "decision_id": {"type": "string", "pattern": "^dm:memory-decision:v1:[A-Za-z0-9_-]{43}$"},
    "policy_id": {"type": "string", "pattern": "^dm:memory-policy:v1:[A-Za-z0-9_-]{43}$"},
    "candidate_id": {"type": "string", "pattern": "^dm:memory-candidate:v1:[A-Za-z0-9_-]{43}$"},
    "predecessor_decision_id": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^dm:memory-decision:v1:[A-Za-z0-9_-]{43}$"}]},
    "subject_me_id": {"type": "string", "pattern": "^[A-Za-z0-9._:@-]{1,256}$"},
    "checkpoint": {"$ref": "checkpoint.schema.json"},
    "evaluated_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "expires_at_ms": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "outcome": {"enum": ["eligible", "review-required", "deferred:incomplete", "quarantined", "rejected"]},
    "reasons": {"type": "array", "uniqueItems": true, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
  }
}
