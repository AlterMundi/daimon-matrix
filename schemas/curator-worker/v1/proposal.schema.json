{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daimon.network/schemas/curator-worker/v1/proposal.schema.json",
  "title": "Evidence-only curator worker proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "proposal_id", "task_id", "attempt_id", "claim_id", "request_hash", "provider", "profile_id", "model", "prompt_hash", "output_schema_hash", "proposal_kind", "content_ref", "category", "derivation", "evidence_refs", "contradiction_refs", "classification_suggestion", "confidence", "uncertainty_labels", "warnings", "response", "produced_at_ms", "authority"],
  "properties": {
    "schema": {"const": "dm.curator-worker.proposal/v1"},
    "proposal_id": {"type": "string", "pattern": "^dm:curator-proposal:v1:[A-Za-z0-9_-]{43}$"},
    "task_id": {"type": "string", "pattern": "^dm:curator-task:v1:[A-Za-z0-9_-]{43}$"},
    "attempt_id": {"type": "string", "format": "uuid"},
    "claim_id": {"type": "string", "format": "uuid"},
    "request_hash": {"$ref": "#/$defs/hash"},
    "provider": {"const": "deepseek"},
    "profile_id": {"type": "string", "pattern": "^dm:curator-profile:v1:[A-Za-z0-9_-]{43}$"},
    "model": {"const": "deepseek-v4-pro"},
    "prompt_hash": {"$ref": "#/$defs/hash"},
    "output_schema_hash": {"$ref": "#/$defs/hash"},
    "proposal_kind": {"enum": ["assert", "correct", "retract"]},
    "content_ref": {"$ref": "#/$defs/content"},
    "category": {"$ref": "#/$defs/scoped"},
    "derivation": {"$ref": "#/$defs/scoped"},
    "evidence_refs": {"$ref": "#/$defs/refs"},
    "contradiction_refs": {"$ref": "#/$defs/refs"},
    "classification_suggestion": {"enum": ["public", "personal", "private", "protected"]},
    "confidence": {"enum": ["low", "medium", "high"]},
    "uncertainty_labels": {"$ref": "#/$defs/labels"},
    "warnings": {"$ref": "#/$defs/labels"},
    "response": {"$ref": "#/$defs/response"},
    "produced_at_ms": {"$ref": "#/$defs/uint"},
    "authority": {"const": "evidence-only"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scoped": {"type": "string", "pattern": "^[A-Za-z0-9._:@-]{1,256}$"},
    "uint": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "refs": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/scoped"}},
    "labels": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/scoped"}},
    "content": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "content_id", "sha256", "byte_length", "media_type", "classification"],
      "properties": {
        "schema": {"const": "dm.curator-worker.content-ref/v1"},
        "content_id": {"type": "string", "pattern": "^dm:curator-content:v1:[A-Za-z0-9_-]{43}$"},
        "sha256": {"$ref": "#/$defs/hash"},
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 131072},
        "media_type": {"const": "text/plain;charset=utf-8"},
        "classification": {"enum": ["public", "personal", "private", "protected"]}
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["prompt_tokens", "completion_tokens", "total_tokens", "prompt_cache_hit_tokens", "prompt_cache_miss_tokens", "reasoning_tokens"],
      "properties": {
        "prompt_tokens": {"$ref": "#/$defs/uint"}, "completion_tokens": {"$ref": "#/$defs/uint"}, "total_tokens": {"$ref": "#/$defs/uint"}, "prompt_cache_hit_tokens": {"$ref": "#/$defs/uint"}, "prompt_cache_miss_tokens": {"$ref": "#/$defs/uint"}, "reasoning_tokens": {"const": 0}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_request_id", "response_hash", "system_fingerprint", "finish_reason", "usage", "provider_created_at_ms", "estimated_cost_microusd"],
      "properties": {
        "provider_request_id": {"type": "string", "minLength": 1, "maxLength": 128}, "response_hash": {"$ref": "#/$defs/hash"}, "system_fingerprint": {"type": ["string", "null"], "maxLength": 128}, "finish_reason": {"const": "stop"}, "usage": {"$ref": "#/$defs/usage"}, "provider_created_at_ms": {"$ref": "#/$defs/uint"}, "estimated_cost_microusd": {"$ref": "#/$defs/uint"}
      }
    }
  }
}
