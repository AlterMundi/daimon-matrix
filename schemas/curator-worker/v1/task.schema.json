{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daimon.network/schemas/curator-worker/v1/task.schema.json",
  "title": "Exact policy-authorized curator worker task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "attempt_id", "idempotency_key", "item", "claim", "policy", "candidate", "checkpoint", "policy_plan", "profile_id", "profile_hash", "allowed_proposal_kinds", "prompt_id", "prompt_hash", "output_schema_id", "output_schema_hash", "created_at_ms", "deadline_ms"],
  "properties": {
    "schema": {"const": "dm.curator-worker.task/v1"},
    "task_id": {"type": "string", "pattern": "^dm:curator-task:v1:[A-Za-z0-9_-]{43}$"},
    "attempt_id": {"type": "string", "format": "uuid"},
    "idempotency_key": {"$ref": "#/$defs/hash"},
    "item": {"$ref": "../../curator/v1/item.schema.json"},
    "claim": {"$ref": "../../curator/v1/claim.schema.json"},
    "policy": {"$ref": "../../memory/v1/policy.schema.json"},
    "candidate": {"$ref": "../../memory/v1/candidate.schema.json"},
    "checkpoint": {"$ref": "../../memory/v1/checkpoint.schema.json"},
    "policy_plan": {"$ref": "../../memory/v1/transition-plan.schema.json"},
    "profile_id": {"type": "string", "pattern": "^dm:curator-profile:v1:[A-Za-z0-9_-]{43}$"},
    "profile_hash": {"$ref": "#/$defs/hash"},
    "allowed_proposal_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["assert", "correct", "retract"]}},
    "prompt_id": {"const": "dm.curator-worker.prompt/v1"},
    "prompt_hash": {"$ref": "#/$defs/hash"},
    "output_schema_id": {"const": "dm.curator-worker.provider-output/v1"},
    "output_schema_hash": {"$ref": "#/$defs/hash"},
    "created_at_ms": {"$ref": "#/$defs/uint"},
    "deadline_ms": {"$ref": "#/$defs/uint"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "uint": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  }
}
