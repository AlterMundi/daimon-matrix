{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daimon.network/schemas/cluster/v1/resource-fence-evidence.schema.json",
  "title": "Daimon Cluster resource fence evidence V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "body_ref", "holder_embodiment_id", "holder_incarnation_id", "resource_ref", "epoch", "observed_at_ms", "expires_at_ms", "verification_ref", "content_hash"],
  "properties": {
    "schema": {"const": "dm.cluster-resource-fence-evidence/v1"},
    "body_ref": {"$ref": "#/$defs/text"},
    "holder_embodiment_id": {"$ref": "#/$defs/text"},
    "holder_incarnation_id": {"$ref": "#/$defs/text"},
    "resource_ref": {"$ref": "#/$defs/text"},
    "epoch": {"$ref": "#/$defs/uint"},
    "observed_at_ms": {"$ref": "#/$defs/uint"},
    "expires_at_ms": {"$ref": "#/$defs/uint"},
    "verification_ref": {"$ref": "#/$defs/text"},
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 240},
    "uint": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
