{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daimon.network/schemas/clients/v1/client.schema.json",
  "title": "Daimon owner-local client documents V1",
  "oneOf": [
    {"$ref": "#/$defs/config"},
    {"$ref": "#/$defs/cliResult"},
    {"$ref": "#/$defs/mcpResource"}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body_ref", "embodiment_id", "incarnation_id", "principal_id"],
      "properties": {
        "body_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "embodiment_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "incarnation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "principal_id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "capability", "expected_server"],
      "properties": {
        "schema": {"const": "dm.local.client-config/v1"},
        "capability": {"$ref": "../../hosted/v1/local-api.schema.json#/$defs/capability"},
        "expected_server": {"$ref": "#/$defs/origin"}
      }
    },
    "cliResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "method", "request_id", "response"],
      "properties": {
        "schema": {"const": "dm.cli.result/v1"},
        "method": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$"},
        "request_id": {"type": "string", "format": "uuid"},
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "request_id", "request_hash", "server", "completed_at_ms", "ok", "result", "error"],
          "properties": {
            "schema": {"const": "dm.local.response/v1"},
            "request_id": {"type": "string", "format": "uuid"},
            "request_hash": {"$ref": "#/$defs/hash"},
            "server": {"$ref": "#/$defs/origin"},
            "completed_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "ok": {"type": "boolean"},
            "result": {"type": ["object", "null"]},
            "error": {"type": ["object", "null"]}
          }
        }
      }
    },
    "mcpResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "uri", "media_type", "content_sha256", "provenance", "document"],
      "properties": {
        "schema": {"const": "dm.mcp.resource/v1"},
        "uri": {"type": "string", "pattern": "^daimon:"},
        "media_type": {"const": "application/vnd.daimon-matrix+json"},
        "content_sha256": {"$ref": "#/$defs/hash"},
        "provenance": {"$ref": "#/$defs/origin"},
        "document": {"type": "object"}
      }
    }
  }
}
