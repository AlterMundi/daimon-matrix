{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generation",
    "origin",
    "bot_id",
    "chat_id",
    "topic_id",
    "representation",
    "acceptance_digest",
    "proof_key_id"
  ],
  "properties": {
    "schema": {
      "const": "daimon-visibility-policy/v2"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4503599627370495
    },
    "origin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "bot_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4503599627370495
    },
    "chat_id": {
      "type": "integer",
      "minimum": -4503599627370495,
      "maximum": 4503599627370495,
      "not": {
        "const": 0
      }
    },
    "topic_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      ]
    },
    "representation": {
      "const": "plain-json/v2"
    },
    "acceptance_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "proof_key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.daimon-matrix.org/messaging/v2/visibility-policy.schema.json",
  "title": "Explicit mandatory Telegram visibility policy V2",
  "$comment": "Signed application selects this exact policy and runtime-only proof key. Shape is not participant consent. No expiry: current manual revocation is checked by the runtime. No caller-selected destinations, opt-out, token or private key fields."
}
