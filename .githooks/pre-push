#!/bin/sh
# Frozen-value drift is the cheapest possible red head to prevent and the most
# annoying to discover, because it surfaces in the slowest CI job. Install with:
#   git config core.hooksPath .githooks
set -e
if [ -n "${FROZEN_CHECK_PYTHON:-}" ]; then
    PYTHON="$FROZEN_CHECK_PYTHON"
elif [ -x ".venv/bin/python" ]; then
    PYTHON=".venv/bin/python"
elif [ -x "../venv/bin/python" ]; then
    PYTHON="../venv/bin/python"
else
    PYTHON="python3"
fi
exec "$PYTHON" tools/check_frozen_invariants.py
